{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tabellio.dev/schemas/plane-work-item-snapshot.v0.1.schema.json",
  "title": "Tabellio Plane work-item snapshot v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workspace", "capturedAt", "status", "projects", "states", "workItems"],
  "properties": {
    "schemaVersion": { "const": "tabellio-plane-work-items/v0.1" },
    "workspace": { "type": "string", "pattern": "^[a-z0-9-]{1,100}$" },
    "capturedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["available", "blocked"] },
    "reason": { "type": ["string", "null"], "maxLength": 200 },
    "projects": { "type": "array", "items": { "$ref": "#/$defs/project" } },
    "states": { "type": "array", "items": { "$ref": "#/$defs/state" } },
    "workItems": { "type": "array", "items": { "$ref": "#/$defs/workItem" } }
  },
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12}$" },
    "project": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "identifier"],
      "properties": { "id": { "$ref": "#/$defs/uuid" }, "identifier": { "type": "string", "minLength": 1, "maxLength": 32 } }
    },
    "state": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "projectId", "group"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" }, "projectId": { "$ref": "#/$defs/uuid" },
        "group": { "enum": ["backlog", "unstarted", "started", "completed", "cancelled"] }
      }
    },
    "workItem": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "projectId", "stateId", "sequenceNumber", "createdAt", "updatedAt", "targetDate"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" }, "projectId": { "$ref": "#/$defs/uuid" }, "stateId": { "$ref": "#/$defs/uuid" }, "sequenceNumber": { "type": "integer", "minimum": 1 },
        "createdAt": { "type": "string", "format": "date-time" }, "updatedAt": { "type": "string", "format": "date-time" },
        "targetDate": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    }
  }
}
