{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tabellio.dev/schemas/provenance-security-review.schema.json",
  "title": "Candidate-bound security check evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidate",
    "packetDigest",
    "policyDigest",
    "observedAt",
    "status",
    "checks",
    "digest"
  ],
  "properties": {
    "schemaVersion": {
      "const": "tabellio-security-review/v0.1"
    },
    "candidate": {
      "$ref": "#/$defs/candidate"
    },
    "packetDigest": {
      "$ref": "#/$defs/digest"
    },
    "policyDigest": {
      "$ref": "#/$defs/digest"
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "blocked"
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectKey",
        "repositoryId",
        "baseCommit",
        "headCommit",
        "mergeBase",
        "id"
      ],
      "properties": {
        "projectKey": {
          "$ref": "#/$defs/text"
        },
        "repositoryId": {
          "$ref": "#/$defs/text"
        },
        "baseCommit": {
          "$ref": "#/$defs/oid"
        },
        "headCommit": {
          "$ref": "#/$defs/oid"
        },
        "mergeBase": {
          "$ref": "#/$defs/oid"
        },
        "id": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "oid": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "\\S"
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "ruleId",
        "severity",
        "path",
        "line",
        "evidenceDigest"
      ],
      "properties": {
        "category": {
          "enum": [
            "secrets",
            "authorization",
            "trust",
            "dependencies"
          ]
        },
        "ruleId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,79}$"
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "path": {
          "$ref": "#/$defs/text"
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "evidenceDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "status",
        "findings"
      ],
      "properties": {
        "category": {
          "enum": [
            "secrets",
            "authorization",
            "trust",
            "dependencies"
          ]
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "blocked"
          ]
        },
        "findings": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/finding"
          }
        }
      }
    }
  }
}
