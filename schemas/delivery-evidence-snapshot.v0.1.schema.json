{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tabellio.dev/schemas/delivery-evidence-snapshot.v0.1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "repository", "capturedAt", "sources", "wipByProject", "deliveryRecords"],
  "properties": {
    "schemaVersion": { "const": "tabellio-delivery-evidence-snapshot/v0.1" },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,38}/[A-Za-z0-9][A-Za-z0-9._-]{0,99}$" },
    "capturedAt": { "type": "string", "format": "date-time" },
    "sources": { "type": "object", "additionalProperties": false, "required": ["provider", "plane", "buildkite", "githubRelease", "deployment"], "properties": { "provider": { "$ref": "#/$defs/source" }, "plane": { "$ref": "#/$defs/source" }, "buildkite": { "$ref": "#/$defs/source" }, "githubRelease": { "$ref": "#/$defs/source" }, "deployment": { "$ref": "#/$defs/source" } } },
    "wipByProject": { "type": "array", "items": { "$ref": "#/$defs/wip" } },
    "deliveryRecords": { "type": "array", "items": { "$ref": "#/$defs/record" } }
  },
  "$defs": {
    "source": { "type": "object", "additionalProperties": false, "required": ["status", "reason", "observations"], "properties": { "status": { "enum": ["available", "blocked", "unavailable"] }, "reason": { "type": ["string", "null"], "maxLength": 200 }, "observations": { "type": "array", "items": { "$ref": "#/$defs/observation" } } } },
    "observation": { "type": "object", "additionalProperties": false, "required": ["id", "version", "digest"], "properties": { "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,191}$" }, "version": { "type": "string", "format": "date-time" }, "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } },
    "wip": { "type": "object", "additionalProperties": false, "required": ["project", "activeItemCount", "aging3dCount", "overLimit"], "properties": { "project": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{0,31}$" }, "activeItemCount": { "type": "integer", "minimum": 0 }, "aging3dCount": { "type": "integer", "minimum": 0 }, "overLimit": { "type": "boolean" } } },
    "record": { "type": "object", "additionalProperties": false, "required": ["id", "linkBasis", "pullRequestNumber", "headCommit", "plane", "ci", "release", "deployment"], "properties": {
      "id": { "type": "string", "minLength": 1, "maxLength": 128 }, "linkBasis": { "enum": ["explicit", "manual-reconciliation", "unlinked"] }, "pullRequestNumber": { "type": ["integer", "null"], "minimum": 1 }, "headCommit": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
      "plane": { "$ref": "#/$defs/plane" }, "ci": { "$ref": "#/$defs/ci" }, "release": { "$ref": "#/$defs/release" }, "deployment": { "$ref": "#/$defs/deployment" }
    } },
    "plane": { "type": "object", "additionalProperties": false, "required": ["status", "key", "stateGroup", "updatedAt"], "properties": { "status": { "enum": ["linked", "unlinked", "blocked"] }, "key": { "type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9]{0,31}-[1-9][0-9]*$" }, "stateGroup": { "type": ["string", "null"], "enum": ["backlog", "unstarted", "started", "completed", "cancelled", null] }, "updatedAt": { "type": ["string", "null"], "format": "date-time" } } },
    "ci": { "type": "object", "additionalProperties": false, "required": ["status", "pipeline", "buildNumber", "finishedAt"], "properties": { "status": { "enum": ["passed", "failed", "in_progress", "unavailable", "blocked"] }, "pipeline": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,127}$" }, "buildNumber": { "type": ["integer", "null"], "minimum": 1 }, "finishedAt": { "type": ["string", "null"], "format": "date-time" } } },
    "release": { "type": "object", "additionalProperties": false, "required": ["status", "tagName", "publishedAt"], "properties": { "status": { "enum": ["shipped", "unreleased", "blocked"] }, "tagName": { "type": ["string", "null"], "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$" }, "publishedAt": { "type": ["string", "null"], "format": "date-time" } } },
    "deployment": { "type": "object", "additionalProperties": false, "required": ["status", "environment", "provider", "deployedAt"], "properties": { "status": { "enum": ["passed", "failed", "blocked", "unavailable"] }, "environment": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" }, "provider": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" }, "deployedAt": { "type": ["string", "null"], "format": "date-time" } } }
  }
}
