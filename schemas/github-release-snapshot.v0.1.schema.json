{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intelip.co/tabellio/schemas/github-release-snapshot.v0.1.schema.json",
  "title": "Tabellio GitHub release snapshot v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repository", "capturedAt", "status", "reason", "releases"],
  "properties": {
    "schemaVersion": { "const": "tabellio-github-release-snapshot/v0.1" },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,38}/[A-Za-z0-9][A-Za-z0-9._-]{0,99}$" },
    "capturedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["available", "blocked"] },
    "reason": {
      "oneOf": [
        { "$ref": "#/$defs/safeText" },
        { "type": "null" }
      ]
    },
    "releases": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "tagName", "publishedAt", "commit", "commitStatus"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
          "tagName": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^(?!@(?:$|/))(?!.*(?:\\.\\.|@\\{|//))(?!.*(?:^|/)\\.)(?!.*(?:\\.|\\.lock)(?:/|$))[A-Za-z0-9+_-][A-Za-z0-9._+@/-]{0,127}$"
          },
          "publishedAt": { "type": "string", "format": "date-time" },
          "commit": { "type": ["string", "null"], "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
          "commitStatus": { "enum": ["resolved", "blocked"] }
        }
      }
    }
  },
  "$defs": {
    "safeText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "allOf": [
        { "not": { "pattern": "[\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\\\|]" } },
        { "not": { "pattern": "[fF][iI][lL][eE]:" } },
        { "not": { "pattern": "(?:^|[\\s=:(\\[\\]'\"`])/(?!/)\\S*" } },
        { "not": { "pattern": "(?:^|[\\s=:(\\[\\]'\"`])\\.\\.?/\\S*" } },
        { "not": { "pattern": "(?:^|[\\s=:(])~(?:/|$)" } },
        { "not": { "pattern": "(?:^|[^A-Za-z0-9._-])[A-Za-z]:/(?:\\S*)" } },
        { "not": { "pattern": "(?:^|[^A-Za-z0-9])[gG][hH][pPoOuUsSrR]_[A-Za-z0-9_]{8,}" } },
        { "not": { "pattern": "(?:^|[^A-Za-z0-9])[gG][iI][tT][hH][uU][bB]_[pP][aA][tT]_[A-Za-z0-9_]{8,}" } },
        { "not": { "pattern": "(?:^|[^A-Za-z0-9])[sS][kK]-(?:[lL][iI][vV][eE]|[pP][rR][oO][jJ])[_-][A-Za-z0-9_-]{8,}" } },
        { "not": { "pattern": "\\bAKIA[0-9A-Z]{16}\\b" } },
        { "not": { "pattern": "://[^/\\s@]+@" } }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "available" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "reason": { "type": "null" }
        }
      },
      "else": {
        "properties": {
          "reason": { "type": "string", "minLength": 1 },
          "releases": { "maxItems": 0 }
        }
      }
    }
  ]
}
