{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intelip.co/tabellio/schemas/analytics-provider-snapshot.v0.1.schema.json",
  "title": "Tabellio analytics provider snapshot v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repository", "headCommit", "capturedAt", "sources", "deliveryChanges"],
  "properties": {
    "schemaVersion": { "const": "tabellio-analytics-provider-snapshot/v0.1" },
    "repository": { "$ref": "#/$defs/repositoryIdentifier" },
    "headCommit": { "$ref": "#/$defs/commit" },
    "capturedAt": { "type": "string", "format": "date-time" },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plane", "github", "github-actions", "buildkite"],
      "properties": {
        "plane": { "$ref": "#/$defs/source" },
        "github": { "$ref": "#/$defs/source" },
        "github-actions": { "$ref": "#/$defs/source" },
        "buildkite": { "$ref": "#/$defs/source" }
      }
    },
    "deliveryChanges": {
      "type": "array",
      "items": { "$ref": "#/$defs/deliveryChange" }
    }
  },
  "$defs": {
    "repositoryIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}/[A-Za-z0-9][A-Za-z0-9._-]{0,99}$",
      "allOf": [
        { "not": { "pattern": "(?:^|[^A-Za-z0-9])[gG][hH][pPoOuUsSrR]_[A-Za-z0-9_]{8,}" } },
        { "not": { "pattern": "(?:^|[^A-Za-z0-9])[gG][iI][tT][hH][uU][bB]_[pP][aA][tT]_[A-Za-z0-9_]{8,}" } },
        { "not": { "pattern": "(?:^|[^A-Za-z0-9])[sS][kK]-(?:[lL][iI][vV][eE]|[pP][rR][oO][jJ])[_-][A-Za-z0-9_-]{8,}" } },
        { "not": { "pattern": "\\bAKIA[0-9A-Z]{16}\\b" } }
      ]
    },
    "commit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "portableIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
      "allOf": [
        { "not": { "pattern": "^[fF][iI][lL][eE]:" } },
        { "not": { "pattern": ":/" } },
        { "not": { "pattern": "//" } },
        { "not": { "pattern": "\\.\\." } },
        { "not": { "pattern": "(?:^|[^A-Za-z0-9])[gG][hH][pPoOuUsSrR]_[A-Za-z0-9_]{8,}" } },
        { "not": { "pattern": "(?:^|[^A-Za-z0-9])[gG][iI][tT][hH][uU][bB]_[pP][aA][tT]_[A-Za-z0-9_]{8,}" } },
        { "not": { "pattern": "(?:^|[^A-Za-z0-9])[sS][kK]-(?:[lL][iI][vV][eE]|[pP][rR][oO][jJ])[_-][A-Za-z0-9_-]{8,}" } },
        { "not": { "pattern": "\\bAKIA[0-9A-Z]{16}\\b" } }
      ]
    },
    "safeText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "allOf": [
        { "not": { "pattern": "[\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\\\|]" } },
        { "not": { "pattern": "[fF][iI][lL][eE]:" } },
        { "not": { "pattern": "(?:^|[\\s=:(\\[\\]'\"`])/(?!/)\\S*" } },
        { "not": { "pattern": "(?:^|[\\s=:(\\[\\]'\"`])\\.\\.?/\\S*" } },
        { "not": { "pattern": "(?:^|[\\s=:(])~(?:/|$)" } },
        { "not": { "pattern": "(?:^|[^A-Za-z0-9._-])[A-Za-z]:/(?:\\S*)" } },
        { "not": { "pattern": "(?:^|[^A-Za-z0-9])[gG][hH][pPoOuUsSrR]_[A-Za-z0-9_]{8,}" } },
        { "not": { "pattern": "(?:^|[^A-Za-z0-9])[gG][iI][tT][hH][uU][bB]_[pP][aA][tT]_[A-Za-z0-9_]{8,}" } },
        { "not": { "pattern": "(?:^|[^A-Za-z0-9])[sS][kK]-(?:[lL][iI][vV][eE]|[pP][rR][oO][jJ])[_-][A-Za-z0-9_-]{8,}" } },
        { "not": { "pattern": "\\bAKIA[0-9A-Z]{16}\\b" } },
        { "not": { "pattern": "://[^/\\s@]+@" } }
      ]
    },
    "safeVersion": {
      "allOf": [
        { "$ref": "#/$defs/safeText" },
        { "maxLength": 200 }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["available", "unavailable", "blocked"] },
        "version": {
          "oneOf": [
            { "$ref": "#/$defs/safeVersion" },
            { "type": "null" }
          ]
        },
        "reason": { "$ref": "#/$defs/safeText" },
        "workspace": { "$ref": "#/$defs/portableIdentifier" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "available" } },
            "required": ["status"]
          },
          "then": {
            "required": ["version"],
            "properties": { "version": { "$ref": "#/$defs/safeVersion" } },
            "not": { "required": ["reason"] }
          },
          "else": {
            "required": ["reason"],
            "properties": { "version": { "type": "null" } }
          }
        }
      ]
    },
    "deliveryChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "linkBasis",
        "linkEvidence",
        "planeStoryId",
        "pullRequestNumber",
        "storyCreatedAt",
        "firstActivityAt",
        "mergedAt",
        "headCommit",
        "validationStatus",
        "hostedStatus"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/portableIdentifier" },
        "linkBasis": { "enum": ["explicit", "manual-reconciliation", "unlinked"] },
        "linkEvidence": {
          "oneOf": [
            { "$ref": "#/$defs/safeText" },
            { "type": "null" }
          ]
        },
        "planeStoryId": {
          "oneOf": [
            { "$ref": "#/$defs/portableIdentifier" },
            { "type": "null" }
          ]
        },
        "pullRequestNumber": { "type": ["integer", "null"], "minimum": 1 },
        "storyCreatedAt": { "type": ["string", "null"], "format": "date-time" },
        "firstActivityAt": { "type": ["string", "null"], "format": "date-time" },
        "mergedAt": { "type": ["string", "null"], "format": "date-time" },
        "mergeCommit": {
          "oneOf": [
            { "$ref": "#/$defs/commit" },
            { "type": "null" }
          ]
        },
        "releasedAt": { "type": ["string", "null"], "format": "date-time" },
        "releaseCommit": {
          "oneOf": [
            { "$ref": "#/$defs/commit" },
            { "type": "null" }
          ]
        },
        "headCommit": { "$ref": "#/$defs/commit" },
        "validationStatus": { "enum": ["passed", "failed", "blocked", "unavailable"] },
        "hostedStatus": { "enum": ["passed", "failed", "blocked", "unavailable"] }
      },
      "allOf": [
        {
          "if": {
            "properties": { "linkBasis": { "const": "unlinked" } },
            "required": ["linkBasis"]
          },
          "then": {
            "properties": {
              "linkEvidence": { "type": "null" },
              "planeStoryId": { "type": "null" },
              "pullRequestNumber": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "planeStoryId": { "$ref": "#/$defs/portableIdentifier" },
              "pullRequestNumber": { "type": "integer", "minimum": 1 }
            }
          }
        }
      ]
    }
  }
}
