{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tabellio.dev/schemas/buildkite-build-snapshot.v0.1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repository",
    "organization",
    "pipeline",
    "capturedAt",
    "status",
    "reason",
    "builds"
  ],
  "properties": {
    "schemaVersion": {"const": "tabellio-buildkite-build-snapshot/v0.1"},
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,38}/[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
    },
    "organization": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,62}[A-Za-z0-9]$|^[A-Za-z0-9]$"
    },
    "pipeline": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,126}[A-Za-z0-9]$|^[A-Za-z0-9]$"
    },
    "capturedAt": {"type": "string", "format": "date-time"},
    "status": {"enum": ["available", "blocked"]},
    "reason": {"type": ["string", "null"], "maxLength": 200},
    "builds": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "number",
          "commit",
          "state",
          "createdAt",
          "finishedAt",
          "jobCount",
          "artifactCount"
        ],
        "properties": {
          "number": {"type": "integer", "minimum": 1},
          "commit": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
          },
          "state": {
            "enum": [
              "blocked",
              "canceled",
              "canceling",
              "creating",
              "failed",
              "failing",
              "not_run",
              "passed",
              "running",
              "scheduled",
              "skipped"
            ]
          },
          "createdAt": {"type": "string", "format": "date-time"},
          "finishedAt": {"type": ["string", "null"], "format": "date-time"},
          "jobCount": {"type": "integer", "minimum": 0, "maximum": 5000},
          "artifactCount": {"type": "integer", "minimum": 0, "maximum": 5000}
        }
      }
    }
  }
}
