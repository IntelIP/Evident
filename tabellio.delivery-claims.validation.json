      "type": "security",
      "argv": ["node", "scripts/tabellio-validator.mjs", "--profile", "delivery-claims-security", "--validator-id", "delivery-claims-security", "--out", ".artifacts/tabellio/delivery-claims-security.json"],
      "cwd": ".",
